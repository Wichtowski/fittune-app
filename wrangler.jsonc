{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fittune",
  "compatibility_date": "2026-09-01",
  // Custom domain: Cloudflare creates and owns the DNS record, so no manual A/AAAA record may exist for it
  "routes": [{ "pattern": "fittune.oskarwichtowski.com", "custom_domain": true }],
  // Static SPA on Workers assets: unknown paths fall back to index.html for client routing.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
